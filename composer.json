{
    "name": "whatstoot/wa-bot",
    "description": "WhatsApp Bot for organizing work order images on Google Drive",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "google/apiclient": "^2.15",
        "vlucas/phpdotenv": "^5.6",
        "ext-pdo_sqlite": "*",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "WhatsToot\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
