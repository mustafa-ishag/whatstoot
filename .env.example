# =============================================
# WhatsToot Bot - Environment Configuration
# =============================================

# App Environment (production / development)
APP_ENV=production
APP_URL=http://whatstoot.example.com
APP_DEBUG=false
APP_TIMEZONE=Asia/Riyadh

# Server Port
PORT=3000

# =============================================
# Storage Engine: synology or gdrive
# =============================================
STORAGE_ENGINE=synology

# Synology NAS Settings (QuickConnect)
SYNOLOGY_URL=https://toot-sa.sg4.quickconnect.to
SYNOLOGY_USER=mustafa.ishag-UC
SYNOLOGY_PASS=TOOTco@2030$
SYNOLOGY_BASE_PATH="/المقاولات/العقد الموحد/work_orders"

# Google Drive Settings (unused if STORAGE_ENGINE=synology)
# GDRIVE_CREDENTIALS_PATH=credentials/google-service-account.json
# GDRIVE_ROOT_FOLDER_ID=YOUR_ROOT_FOLDER_ID_HERE

# =============================================
# Work Order Settings
# =============================================
WORK_ORDER_DIGITS=9
AWAIT_TIMEOUT_SECONDS=90

# =============================================
# Monitored Groups (comma-separated group IDs, or "all" for all groups)
# =============================================
MONITORED_GROUPS=all

# Auto-reply after upload (true/false)
AUTO_REPLY_ENABLED=true

# =============================================
# Email Reader Settings (IMAP)
# =============================================
EMAIL_IMAP_HOST=mail.toot-t.com
EMAIL_IMAP_PORT=993
EMAIL_USER=permit@toot-t.com
EMAIL_PASS=YOUR_EMAIL_PASSWORD_HERE
EMAIL_CHECK_INTERVAL=60
EMAIL_WHATSAPP_NUMBER=0537266407
EMAIL_ENABLED=true
