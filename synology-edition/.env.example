# ==============================================================================
# WhatsToot Bot — إعدادات نسخة السنولوجي (Synology Edition Example)
# ==============================================================================

# البيئة والمنفذ
APP_ENV=production
PORT=3000
API_KEY=your_secure_api_key_here
APP_TIMEZONE=Asia/Riyadh

# إعدادات أمر العمل
WORK_ORDER_DIGITS=9
AWAIT_TIMEOUT_SECONDS=90
AUTO_REPLY_ENABLED=true

# المجموعات المراقبة (all لمراقبة كل المجموعات أو أسماء مفصولة بفاصلة)
MONITORED_GROUPS=all

# محرك التخزين (synology)
STORAGE_ENGINE=synology

# إعدادات السنولوجي
SYNOLOGY_URL=https://your-synology-address:5001
SYNOLOGY_USER=your_username
SYNOLOGY_PASS=your_password
SYNOLOGY_BASE_PATH="/volume1/photo/work_orders"

# إعدادات قارئ البريد الإلكتروني (Email Reader)
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_CHECK_INTERVAL=60
EMAIL_WHATSAPP_NUMBER=05xxxxxxxx
EMAIL_ENABLED=true

# إعدادات تنبيهات البريد للمشرف (Admin Alerts)
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=465
ALERT_SMTP_USER=your_alert_email@gmail.com
ALERT_SMTP_PASS=your_alert_app_password
ALERT_EMAIL_TO=admin@example.com
ALERT_ENABLED=true
